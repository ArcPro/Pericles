APP_ENV=development
APP_URL=http://localhost/Pericles/Site/public

ACCESS_TOKEN_TTL=3600
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=300
DEVICE_CHALLENGE_TTL=60
MAX_DEVICES_PER_USER=3
ACTIVATION_RATE_LIMIT=10
ACTIVATION_RATE_WINDOW=900

MODULE_TICKET_TTL=30
MAX_MODULE_SIZE_MB=50
MODULE_TICKET_RATE_LIMIT=20
MODULE_DOWNLOAD_RATE_LIMIT=10
MODULE_RATE_WINDOW=60
MODULE_SIGNING_KEY_ID=pericles-modules-development-test
MODULE_SIGNING_PRIVATE_KEY_PATH=

PASSWORD_RESET_TTL=1800
PASSWORD_RESET_LIMIT=3
MAIL_FROM=no-reply@pericles.gg
SUPPORT_EMAIL=support@pericles.gg
LAUNCHER_DOWNLOAD_URL=

# Stripe Elements stays disabled while any of the three Stripe keys is empty.
PAYMENT_PROVIDER=stripe
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Legacy generic hosted-provider integration (unused when PAYMENT_PROVIDER=stripe).
PAYMENT_CHECKOUT_URL=
PAYMENT_WEBHOOK_SECRET=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pericles
DB_USER=pericles
DB_PASS=change-me
DB_CHARSET=utf8mb4
