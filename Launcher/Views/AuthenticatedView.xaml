<UserControl x:Class="Launcher.Views.AuthenticatedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="NavButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="50"/><Setter Property="Margin" Value="0,3"/><Setter Property="Padding" Value="16,0"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="B" CornerRadius="8" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                    <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#191527"/></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="B" Property="Background" Value="#26173F"/><Setter TargetName="B" Property="BorderBrush" Value="#7143B4"/><Setter Property="Foreground" Value="#C7A8FF"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/><Setter Property="Padding" Value="16,0"/><Setter Property="Background" Value="#17131F"/>
            <Setter Property="Foreground" Value="#C7A8FF"/><Setter Property="BorderBrush" Value="#5A3C83"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
            <Setter Property="Background" Value="#7137D6"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#9D68F5"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#0F0D16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Margin="18,18,18,12">
            <Grid.RowDefinitions><RowDefinition Height="155"/><RowDefinition Height="*"/><RowDefinition Height="60"/></Grid.RowDefinitions>
            <Border Padding="14" CornerRadius="12" Background="#17141F" BorderBrush="#352B45" BorderThickness="1">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="46" Height="46" CornerRadius="23" VerticalAlignment="Top" Background="#2B1A48" BorderBrush="#8954DC" BorderThickness="1.5">
                        <TextBlock x:Name="AvatarLetter" Text="P" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="19" FontWeight="Bold" Foreground="#D8C4FF"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="8,1,0,0">
                        <TextBlock x:Name="PlayerNameText" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="EmailText" Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                        <Button x:Name="ToggleEmailButton" Content="Masquer l’email" Click="ToggleEmailButton_Click" HorizontalAlignment="Left" Margin="-7,4,0,0" Padding="7,2" Background="Transparent" BorderThickness="0" Foreground="#81788E" FontSize="10" Cursor="Hand"/>
                        <Border HorizontalAlignment="Left" Margin="0,7,0,0" Padding="8,3" CornerRadius="4" Background="#5C2EA0"><TextBlock x:Name="GradeText" Text="MEMBRE" FontSize="10" FontWeight="Bold"/></Border>
                    </StackPanel>
                </Grid>
            </Border>
            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                <RadioButton x:Name="GamesNavigation" Content="◆    JEUX" GroupName="Navigation" IsChecked="True" Style="{StaticResource NavButtonStyle}" Tag="Games" Checked="Navigation_Checked"/>
                <RadioButton Content="●    PROFIL" GroupName="Navigation" Style="{StaticResource NavButtonStyle}" Tag="Profile" Checked="Navigation_Checked"/>
                <RadioButton Content="⚙    PARAMÈTRES" GroupName="Navigation" Style="{StaticResource NavButtonStyle}" Tag="Settings" Checked="Navigation_Checked"/>
                <RadioButton Content="?    SUPPORT" GroupName="Navigation" Style="{StaticResource NavButtonStyle}" Tag="Support" Checked="Navigation_Checked"/>
            </StackPanel>
            <Button x:Name="LogoutButton" Grid.Row="2" Content="↪   SE DÉCONNECTER" Click="LogoutButton_Click" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Cursor="Hand"/>
        </Grid>
        <Border Grid.Column="1" Background="#30283D"/>

        <Grid Grid.Column="2">
            <ScrollViewer x:Name="GamesPage" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="34,26,34,34">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Jeux" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="Votre catalogue, synchronisé avec Pericles." Margin="0,7,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="13"/></StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="ACTUALISER" Margin="0,0,9,0" Style="{StaticResource GhostButtonStyle}" Click="Refresh_Click"/>
                            <Button Content="ACTIVER UNE CLÉ" Style="{StaticResource GhostButtonStyle}" Click="OpenActivation_Click"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="À LA UNE" Margin="0,26,0,12" FontSize="12" FontWeight="Bold" Foreground="#A89DB8"/>
                    <Border x:Name="FeaturedCard" Height="210" CornerRadius="11" ClipToBounds="True" BorderBrush="#4B3B63" BorderThickness="1" Visibility="Collapsed">
                        <Grid Background="#15111E">
                            <Border x:Name="FeaturedImagePlaceholder" Background="#211A2D"/>
                            <Image x:Name="FeaturedImage" Stretch="UniformToFill" Opacity="0.62"/>
                            <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FF0C0914" Offset="0"/><GradientStop Color="#EC0C0914" Offset="0.48"/><GradientStop Color="#330C0914" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                            <StackPanel Width="390" Margin="30,24" HorizontalAlignment="Left">
                                <TextBlock x:Name="FeaturedState" Foreground="#8FF0C6" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="FeaturedName" Margin="0,9,0,0" FontSize="31" FontWeight="Bold"/>
                                <TextBlock x:Name="FeaturedDescription" Margin="0,7,0,14" MaxHeight="42" Foreground="#C2BACD" FontSize="12" TextWrapping="Wrap"/>
                                <Button x:Name="FeaturedAction" Width="210" HorizontalAlignment="Left" Style="{StaticResource ActionButtonStyle}" Click="GameAction_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Text="MA BIBLIOTHÈQUE" Margin="0,28,0,14" FontSize="12" FontWeight="Bold" Foreground="#A89DB8"/>
                    <WrapPanel x:Name="GamesPanel"/>
                    <TextBlock x:Name="GameFeedbackText" Margin="0,16,0,0" Foreground="#B895F5" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ProfilePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="38,30" MaxWidth="780" HorizontalAlignment="Left">
                    <TextBlock Text="Profil" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="Votre compte, vos abonnements et vos appareils." Margin="0,7,0,24" Foreground="{StaticResource MutedTextBrush}" FontSize="13"/>
                    <Border Padding="20" CornerRadius="12" Background="#17141F" BorderBrush="#392E49" BorderThickness="1">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="38"/><RowDefinition Height="38"/><RowDefinition Height="38"/></Grid.RowDefinitions>
                            <TextBlock Text="Pseudo" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/><TextBlock x:Name="ProfileNameText" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="1" Text="Email" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/><TextBlock x:Name="ProfileEmailText" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Text="Grade" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/><TextBlock x:Name="ProfileGradeText" Grid.Row="2" Grid.Column="1" Text="MEMBRE" VerticalAlignment="Center" Foreground="#C7A8FF"/>
                            <TextBlock Grid.Row="3" Text="Appareil" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/><TextBlock Grid.Row="3" Grid.Column="1" Text="● Vérifié" VerticalAlignment="Center" Foreground="{StaticResource SuccessBrush}"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="MES ABONNEMENTS" Margin="0,25,0,12" FontSize="12" FontWeight="Bold" Foreground="#A89DB8"/>
                    <StackPanel x:Name="SubscriptionsPanel"/>
                    <Grid Margin="0,25,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="MES APPAREILS" FontSize="12" FontWeight="Bold" Foreground="#A89DB8"/><TextBlock Grid.Column="1" Text="● Appareil vérifié" FontSize="11" Foreground="{StaticResource SuccessBrush}"/></Grid>
                    <StackPanel x:Name="DevicesPanel"/>
                    <TextBlock x:Name="DeviceFeedbackText" Margin="0,10,0,0" FontSize="11" Foreground="#B895F5" Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed"><StackPanel Margin="38,30" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Text="Paramètres" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="Personnalisez l’affichage du launcher." Margin="0,7,0,24" Foreground="{StaticResource MutedTextBrush}"/>
                <Border Padding="22" CornerRadius="12" Background="#17141F" BorderBrush="#392E49" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Masquer mon email" FontWeight="SemiBold"/><TextBlock Text="Masque partiellement l’adresse dans la barre latérale." Margin="0,5,20,0" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/></StackPanel><CheckBox x:Name="HideEmailCheckBox" Grid.Column="1" VerticalAlignment="Center" Checked="HideEmailCheckBox_Changed" Unchecked="HideEmailCheckBox_Changed"/></Grid></Border>
            </StackPanel></ScrollViewer>
            <ScrollViewer x:Name="SupportPage" Visibility="Collapsed"><StackPanel Margin="38,30" MaxWidth="760" HorizontalAlignment="Left"><TextBlock Text="Support" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="Une question ou un problème avec Pericles ?" Margin="0,7,0,24" Foreground="{StaticResource MutedTextBrush}"/><Border Padding="24" CornerRadius="12" Background="#17141F" BorderBrush="#392E49" BorderThickness="1"><StackPanel><TextBlock Text="Centre d’aide" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Indiquez votre identifiant utilisateur et la version du launcher." Margin="0,8,0,18" Foreground="{StaticResource MutedTextBrush}"/><Button Content="CONTACTER LE SUPPORT" Width="220" HorizontalAlignment="Left" Style="{StaticResource GhostButtonStyle}"/></StackPanel></Border></StackPanel></ScrollViewer>

            <Border x:Name="ActivationOverlay" Background="#CC080711" Visibility="Collapsed">
                <Border Width="430" Padding="26" CornerRadius="14" Background="#17131F" BorderBrush="#7143B4" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Activer une clé" FontSize="21" FontWeight="SemiBold"/><Button Grid.Column="1" Content="×" Width="34" Height="30" Background="Transparent" BorderThickness="0" Foreground="#AAA2B5" FontSize="20" Click="CloseActivation_Click"/></Grid>
                        <TextBlock Text="La clé ajoute ou prolonge l’abonnement du produit associé." Margin="0,8,0,18" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
                        <TextBox x:Name="ActivationKeyText" Height="42" Padding="12,0" VerticalContentAlignment="Center" Background="#0F0D16" Foreground="White" BorderBrush="#4A3B61" MaxLength="80"/>
                        <TextBlock x:Name="ActivationFeedbackText" Margin="0,10,0,0" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>
                        <Button x:Name="ActivationSubmitButton" Content="ACTIVER" Height="40" Margin="0,18,0,0" Style="{StaticResource ActionButtonStyle}" Click="ActivationSubmit_Click"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</UserControl>
